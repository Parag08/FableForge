# Copy to backend/.env and fill in. All keys are required; the server refuses to start otherwise.
PORT=8080
# At least 32 characters. Generate with: openssl rand -base64 48
JWT_SECRET=
# Go duration, e.g. 15m, 1h
TOKEN_TTL=15m
# Exact origin of the frontend dev server (CORS)
ALLOWED_ORIGIN=http://localhost:3000
# Demo-only login until real user storage exists
DEMO_USERNAME=demo
DEMO_PASSWORD=
